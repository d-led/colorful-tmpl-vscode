{
  "name": "colorful-tmpl",
  "displayName": "Colorful tmpl",
  "description": "Colorful syntax highlighting for Go templates — rainbow nesting backgrounds, variable spotting",
  "version": "0.1.2",
  "publisher": "d-led",
  "license": "MPL-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d-led/colorful-tmpl-vscode.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:colorful-tmpl",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "colorful-tmpl.switchPalette",
        "title": "Switch Palette",
        "category": "Colorful tmpl"
      }
    ],
    "languages": [
      {
        "id": "colorful-tmpl",
        "aliases": [
          "Colorful Go Template",
          "colorful-tmpl",
          "gomplate"
        ],
        "extensions": [
          ".gotmpl",
          ".tpl",
          ".gtpl",
          ".gohtml",
          ".tmpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "colorful-tmpl",
        "scopeName": "text.colorful-tmpl",
        "path": "./syntaxes/gotmpl.tmLanguage.json"
      },
      {
        "scopeName": "colorful-tmpl.injection",
        "path": "./syntaxes/gotmpl-injection.json",
        "injectTo": [
          "source",
          "text"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.gotmpl": "colorful-tmpl"
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "colorfulTmplVariable",
        "superType": "variable",
        "description": "A Go template variable ($name)"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "colorfulTmplDefinition",
        "description": "A Go template variable definition ($x :=)"
      },
      {
        "id": "colorfulTmplAssignment",
        "description": "A Go template variable assignment ($x =)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "colorful-tmpl",
        "scopes": {
          "colorfulTmplVariable:colorfulTmplDefinition": [
            "variable.other.readwrite.colorful-tmpl"
          ],
          "colorfulTmplVariable:colorfulTmplAssignment": [
            "variable.other.readwrite.colorful-tmpl"
          ],
          "colorfulTmplVariable": [
            "variable.other.colorful-tmpl"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Colorful tmpl",
      "properties": {
        "colorful-tmpl.palette.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable background highlighting for nested template actions."
        },
        "colorful-tmpl.palette.preset": {
          "type": "string",
          "enum": [
            "default",
            "highContrast",
            "custom"
          ],
          "enumItemLabels": [
            "Default",
            "High Contrast",
            "Custom"
          ],
          "markdownEnumDescriptions": [
            "Theme-aware pastel palette (6 colors, rotates).",
            "Theme-aware high contrast palette — stronger, more opaque backgrounds for low-vision or busy screens.",
            "Use the colors from `#colorful-tmpl.palette.custom#`."
          ],
          "default": "default",
          "markdownDescription": "Which palette to use for nesting backgrounds. `highContrast` also strengthens variable, function, pipe, and comment highlights. `custom` uses `#colorful-tmpl.palette.custom#`. Use the **Colorful tmpl: Switch Palette** command to change it without opening Settings."
        },
        "colorful-tmpl.palette.custom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rgba(173, 216, 230, 0.20)",
            "rgba(144, 238, 144, 0.20)",
            "rgba(255, 218, 185, 0.20)",
            "rgba(221, 160, 221, 0.20)",
            "rgba(255, 255, 150, 0.20)",
            "rgba(255, 182, 193, 0.20)"
          ],
          "markdownDescription": "Custom background colors for nesting levels (rotates). Used when `#colorful-tmpl.palette.preset#` is `custom`. Use rgba() or hex."
        },
        "colorful-tmpl.palette.variableHighlight": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Highlight variable definitions, assignments, and uses with distinct backgrounds."
        },
        "colorful-tmpl.palette.variableDefColor": {
          "type": "string",
          "markdownDescription": "Background color for variable definitions (`$x :=`). Defaults to a theme-aware green."
        },
        "colorful-tmpl.palette.variableAssignColor": {
          "type": "string",
          "markdownDescription": "Background color for variable assignments (`$x =`). Defaults to a theme-aware orange."
        },
        "colorful-tmpl.palette.variableUseColor": {
          "type": "string",
          "markdownDescription": "Background color for variable uses (`$x`). Defaults to a theme-aware blue."
        }
      }
    },
    "configurationDefaults": {
      "[colorful-tmpl]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "node esbuild.extension.mjs",
    "clean": "rm -rf dist",
    "package": "npm run build && npx vsce package --no-dependencies",
    "test": "vitest run",
    "test:vscode": "tsc -p tsconfig.tests.json && vscode-test"
  },
  "devDependencies": {
    "@colorful-tmpl/highlight-core": "0.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "mocha": "^11.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
