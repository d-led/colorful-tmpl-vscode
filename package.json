{
  "name": "colorful-trees-forest-monorepo",
  "private": true,
  "description": "Colorful Go template syntax highlighter — monorepo",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "diff": "8.0.3",
    "glob": "13.0.6"
  },
  "scripts": {
    "bootstrap": "npm install",
    "setup": "npm install && npm run build -w @colorful-tmpl/highlight-core",
    "build": "npm run build -w @colorful-tmpl/highlight-core && npm run build -w colorful-tmpl",
    "clean": "npm run -ws --if-present clean",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'packages/*/syntaxes/*.json'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'packages/*/syntaxes/*.json'",
    "typecheck": "tsc -b",
    "test": "npm run build -w @colorful-tmpl/highlight-core && vitest run -c vitest.config.ts",
    "test:all": "bash scripts/test-all.sh",
    "test:watch": "vitest -c vitest.config.ts",
    "test:coverage": "npm run build -w @colorful-tmpl/highlight-core && vitest run -c vitest.config.ts --coverage",
    "test:vscode": "bash scripts/test-vscode-extension.sh",
    "vscode:package": "bash scripts/install-here.sh --package-only",
    "vscode:install": "bash scripts/install-here.sh",
    "vscode:check": "bash scripts/install-here.sh --check",
    "approvals:test": "vitest run packages/core/src/render-html.approval.test.ts; npm run approvals:glue",
    "approvals:approve:all": "cd packages/core/src && for f in *.received.txt; do [ -f \"$f\" ] && cp \"$f\" \"${f/.received/.approved}\"; done; cd ../../.. && node scripts/glue-approvals.mjs approved",
    "approvals:reject:all": "cd packages/core/src && rm -f *.received.txt",
    "approvals:glue": "node scripts/glue-approvals.mjs all",
    "approvals:view": "npm run approvals:glue && open packages/core/src/approved-dark.html"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "approvals": "^7.3.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
